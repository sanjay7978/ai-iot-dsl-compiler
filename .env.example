# Copy this file to .env and fill in what you want to use.
# All options are free. With nothing set, a local Ollama model is used if
# Ollama is running; otherwise the built-in offline converter is used.

# Choose: auto (default), groq, gemini, ollama, offline
AI_PROVIDER=auto

# Groq (free API key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free API key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (local, free: https://ollama.com, then e.g. `ollama pull qwen3`)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
